[Unit]
Description=Периметр — демо на вымышленных данных
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/perimeter
ExecStart=/opt/perimeter/.venv/bin/python /opt/perimeter/tools/demo.py --port 8091
Restart=on-failure
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
