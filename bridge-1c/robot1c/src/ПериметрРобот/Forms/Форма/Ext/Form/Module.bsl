// Форма робота. Существует ровно ради одного: 1С запускает код обработки
// только при интерактивном открытии — командная строка /Execute не выполняет
// ни тело модуля объекта, ни ПриОткрытии формы (проверено на живой платформе
// 8.3.27 двумя независимыми пробами, 2026-07-31, см. README).
//
// Опрос идёт обработчиком ожидания, а не циклом: робот живёт в сеансе
// бухгалтера, и блокирующий цикл заморозил бы ему 1С.

&НаКлиенте
Перем НастройкиРобота;

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастройкиРобота = ПрочитатьНастройкиНаСервере();
	Если НастройкиРобота = Неопределено Тогда
		Возврат; // нет файла настроек — окно просто открыто, опрос не идёт
	КонецЕсли;
	ПодключитьОбработчикОжидания("ОпроситьШлюз", 3);

КонецПроцедуры

&НаКлиенте
Процедура ОпроситьШлюз()

	// Пока есть задания — забираем их подряд, иначе ждём следующего тика.
	Пока ВыполнитьЦиклНаСервере(НастройкиРобота.gateway, НастройкиРобота.token) Цикл
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВыполнитьЦиклНаСервере(АдресШлюза, Токен)

	Возврат РеквизитФормыВЗначение("Объект").ВыполнитьОдинЦикл(АдресШлюза, Токен);

КонецФункции

&НаСервере
Функция ПрочитатьНастройкиНаСервере()

	Возврат РеквизитФормыВЗначение("Объект").ПрочитатьНастройкиАвтозапуска();

КонецФункции
