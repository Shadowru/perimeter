// Периметр: робот — модуль внешней обработки.
//
// Опрашивает локальный шлюз «Периметра», выполняет задания над базой и
// возвращает результат. Конфигурация не меняется: это внешняя обработка
// (файл .epf), как внешний отчёт.
//
// ВАЖНО (guardrail продукта): робот НЕ проводит документы. Операция
// create_draft создаёт объект с Проведен = Ложь и записывает его в режиме
// РежимЗаписиДокумента.Запись — проведение выполняет человек в 1С.
//
// ВНИМАНИЕ: модуль прошёл синтаксический контроль Конфигуратора 8.3.27 на
// живой платформе Windows («Синтаксических ошибок не обнаружено!»), но его
// код ещё не выполнялся: запуск через 1cv8 ENTERPRISE /Execute тело модуля
// НЕ вызывает (проверено экспериментом 2026-07-31, см. README). Пока нет
// формы, робот запускается только интерактивным открытием обработки.
// Обращения к метаданным проверяются во время работы, поэтому перед первым
// внедрением обязателен прогон на тестовой копии базы заказчика.

#Область СлужебныеПеременные
Перем ПараметрыРаботы;
#КонецОбласти

#Область ПрограммныйИнтерфейс

// Точка входа для блокирующего режима: цикл до закрытия сеанса.
// Годится только для выделенного сеанса робота — рабочий сеанс бухгалтера
// такой цикл заморозит. В сеансе человека используйте ВыполнитьОдинЦикл
// из обработчика ожидания формы (см. форму обработки).
Процедура ВыполнитьРаботу(АдресШлюза, Токен, ИнтервалОпросаСек = 1) Экспорт

	ПараметрыРаботы = Новый Структура("АдресШлюза, Токен", АдресШлюза, Токен);

	Пока Истина Цикл
		Задание = ПолучитьЗадание();
		Если Задание = Неопределено Тогда
			// Шлюз ответил «нет заданий» либо недоступен — ждём и повторяем.
			ПриостановитьВыполнение(ИнтервалОпросаСек);
			Продолжить;
		КонецЕсли;

		Результат = ВыполнитьЗадание(Задание);
		ОтправитьРезультат(Результат);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбменСоШлюзом

// Один проход: забрать задание, выполнить, вернуть результат. Не блокирует
// сеанс надолго — ожидание на шлюзе короткое. Вызывается из обработчика
// ожидания формы, чтобы 1С бухгалтера оставалась отзывчивой.
Функция ВыполнитьОдинЦикл(АдресШлюза, Токен, ОжиданиеСек = 2) Экспорт

	ПараметрыРаботы = Новый Структура("АдресШлюза, Токен", АдресШлюза, Токен);
	Задание = ПолучитьЗадание(ОжиданиеСек);
	Если Задание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОтправитьРезультат(ВыполнитьЗадание(Задание));
	Возврат Истина;

КонецФункции

Функция ПолучитьЗадание(ОжиданиеСек = 25)

	Попытка
		Ответ = ВыполнитьЗапросКШлюзу("GET", "/robot/poll?wait=" + Формат(ОжиданиеСек, "ЧГ=0"), Неопределено);
	Исключение
		Возврат Неопределено; // шлюз не поднят — молча ждём
	КонецПопытки;

	Если Ответ.КодСостояния = 204 Тогда
		Возврат Неопределено; // заданий нет
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПрочитатьJSONИзСтроки(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

Процедура ОтправитьРезультат(Результат)

	Попытка
		ВыполнитьЗапросКШлюзу("POST", "/robot/result", ЗаписатьJSONВСтроку(Результат));
	Исключение
		// Результат потерян — агент получит таймаут и сообщит пользователю.
	КонецПопытки;

КонецПроцедуры

Функция ВыполнитьЗапросКШлюзу(Метод, Ресурс, Тело)

	URI = РазложитьСтрокуURI(ПараметрыРаботы.АдресШлюза);
	Соединение = Новый HTTPСоединение(URI.Хост, URI.Порт, , , , 60);

	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если ЗначениеЗаполнено(ПараметрыРаботы.Токен) Тогда
		Запрос.Заголовки.Вставить("X-Robot-Token", ПараметрыРаботы.Токен);
	КонецЕсли;
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	КонецЕсли;

	Если Метод = "POST" Тогда
		Возврат Соединение.ОтправитьДляОбработки(Запрос);
	Иначе
		Возврат Соединение.Получить(Запрос);
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ВыполнениеЗаданий

Функция ВыполнитьЗадание(Задание)

	Результат = Новый Структура("id, ok", Задание.id, Истина);

	Попытка
		Операция = Задание.op;
		Если Операция = "query" Тогда
			Результат.Вставить("rows", ВыполнитьВыборку(Задание));
		ИначеЕсли Операция = "get" Тогда
			Результат.Вставить("row", ПолучитьОбъектПоСсылке(Задание));
		ИначеЕсли Операция = "create_draft" Тогда
			Результат.Вставить("row", СоздатьЧерновик(Задание));
		ИначеЕсли Операция = "metadata" Тогда
			Результат.Вставить("entities", СоставМетаданных());
		Иначе
			Возврат ОшибкаЗадания(Задание.id, "неизвестная операция: " + Операция);
		КонецЕсли;
	Исключение
		Возврат ОшибкаЗадания(Задание.id, ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ВыполнитьВыборку(Задание)

	ИмяТаблицы = ИмяТаблицыПоЛогическомуИмени(Задание.entity);

	Запрос = Новый Запрос;
	ТекстУсловий = "";
	Условия = Задание.conditions;

	Для Индекс = 0 По Условия.Количество() - 1 Цикл
		Условие = Условия[Индекс];
		ИмяПараметра = "П" + Формат(Индекс, "ЧГ=0");
		ПолеЗапроса = ИмяПоляПоЛогическомуИмени(Условие.field);

		Если Условие.op = "contains" Тогда
			Фрагмент = ПолеЗапроса + " ПОДОБНО &" + ИмяПараметра;
			Запрос.УстановитьПараметр(ИмяПараметра, "%" + Условие.value + "%");
		Иначе
			Знак = ?(Условие.op = "eq", "=", ?(Условие.op = "ge", ">=", "<="));
			Фрагмент = ПолеЗапроса + " " + Знак + " &" + ИмяПараметра;
			Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметра(Условие));
		КонецЕсли;

		ТекстУсловий = ТекстУсловий + ?(ПустаяСтрока(ТекстУсловий), "", " И ") + Фрагмент;
	КонецЦикла;

	// ЗначениеЗаполнено, а не сравнение с Неопределено: отсутствующее поле JSON
	// платформа читает как Null, и проверка «<> Неопределено» дала бы Истину.
	ТекстЗапроса = "ВЫБРАТЬ "
		+ ?(ЗначениеЗаполнено(Задание.top), "ПЕРВЫЕ " + Формат(Задание.top, "ЧГ=0") + " ", "")
		+ "* ИЗ " + ИмяТаблицы + " КАК Т";
	Если НЕ ПустаяСтрока(ТекстУсловий) Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ " + ТекстУсловий;
	КонецЕсли;
	Если ЗначениеЗаполнено(Задание.order_by) Тогда
		ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО " + ИмяПоляПоЛогическомуИмени(Задание.order_by);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;

	Строки = Новый Массив;
	Ссылки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСтроки = СтрокаРезультата(Выборка, Задание.select);
		Строки.Добавить(ДанныеСтроки);
		Если ЕстьКолонка(Выборка, "Ссылка") Тогда
			Ссылки.Добавить(Выборка["Ссылка"]);
		КонецЕсли;
	КонецЦикла;

	// Табличная часть, если её попросили. OData отдаёт её вложенной сама;
	// без этого отчёты по строкам приходили пустыми (живая база 31.07).
	// Частей может быть несколько: в БП у реализации это «Товары» и «Услуги».
	ЧастиДокумента = ?(Задание.Свойство("with_rows"), Задание.with_rows, Неопределено);
	Если ЧастиДокумента <> Неопределено И ЧастиДокумента <> Null И Ссылки.Количество() > 0 Тогда
		Если ТипЗнч(ЧастиДокумента) = Тип("Строка") Тогда
			ДобавитьТабличнуюЧасть(Строки, Ссылки, ИмяТаблицы, ЧастиДокумента);
		Иначе
			Для Каждого ИмяЧасти Из ЧастиДокумента Цикл
				ДобавитьТабличнуюЧасть(Строки, Ссылки, ИмяТаблицы, ИмяЧасти);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Возврат Строки;

КонецФункции

Функция ЕстьКолонка(Выборка, Имя)

	Возврат Выборка.Владелец().Колонки.Найти(Имя) <> Неопределено;

КонецФункции

// Одним запросом добираем строки табличной части для всех отобранных
// документов и раскладываем их по владельцам. По запросу на документ было бы
// в разы медленнее.
Процедура ДобавитьТабличнуюЧасть(Строки, Ссылки, ИмяТаблицы, ИмяТабличнойЧасти)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ " + ИмяТаблицы + "." + ИмяТабличнойЧасти
		+ " КАК Т ГДЕ Т.Ссылка В (&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	ПоВладельцам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Строка(Выборка["Ссылка"].УникальныйИдентификатор());
		Список = ПоВладельцам.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоВладельцам.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(СтрокаРезультата(Выборка, Неопределено));
	КонецЦикла;

	Для Каждого ДанныеСтроки Из Строки Цикл
		Ключ = ?(ДанныеСтроки.Свойство("Ref_Key"), ДанныеСтроки.Ref_Key, "");
		Список = ПоВладельцам.Получить(Ключ);
		ДанныеСтроки.Вставить(ИмяТабличнойЧасти, ?(Список = Неопределено, Новый Массив, Список));
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьОбъектПоСсылке(Задание)

	ИмяТаблицы = ИмяТаблицыПоЛогическомуИмени(Задание.entity);
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + ИмяТаблицы + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", СсылкаИзGUID(Задание.entity, Задание.ref_key));

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокаРезультата(Выборка, Задание.select);

КонецФункции

// Создание ЧЕРНОВИКА. Документ записывается непроведённым — это гарантия
// продукта, снимать её нельзя.
Функция СоздатьЧерновик(Задание)

	ИмяОбъекта = ИмяОбъектаМетаданных(Задание.entity);
	Если НЕ СтрНачинаетсяС(Задание.entity, "Document_") Тогда
		ВызватьИсключение "Создавать разрешено только документы-черновики";
	КонецЕсли;

	Документ = Документы[ИмяОбъекта].СоздатьДокумент();
	Документ.Дата = ТекущаяДата();

	Для Каждого КлючЗначение Из Задание.payload Цикл
		ИмяРеквизита = ИмяПоляБезСуффиксаСсылки(КлючЗначение.Ключ);
		Если ИмяРеквизита = "Posted" ИЛИ ИмяРеквизита = "Проведен" Тогда
			Продолжить; // проведение недоступно
		КонецЕсли;
		Если Документ.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Документ[ИмяРеквизита] = ЗначениеРеквизита(Документ, ИмяРеквизита, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Запись); // НЕ Проведение

	Возврат Новый Структура("Ref_Key, Number, Date, Posted",
		Строка(Документ.Ссылка.УникальныйИдентификатор()),
		Документ.Номер, Формат(Документ.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"), Ложь);

КонецФункции

// Состав метаданных для сверки маппинга: имена сущностей и их реквизитов
// в той же логической схеме, что у OData.
Функция СоставМетаданных()

	Состав = Новый Структура;

	Для Каждого Справочник Из Метаданные.Справочники Цикл
		Состав.Вставить("Catalog_" + Справочник.Имя, ИменаРеквизитов(Справочник, Истина));
	КонецЦикла;
	Для Каждого Документ Из Метаданные.Документы Цикл
		Состав.Вставить("Document_" + Документ.Имя, ИменаРеквизитов(Документ, Ложь));
	КонецЦикла;

	Возврат Состав;

КонецФункции

Функция ИменаРеквизитов(ОбъектМетаданных, ЭтоСправочник)

	Имена = Новый Массив;
	Имена.Добавить("Ref_Key");
	Имена.Добавить("DeletionMark");
	Если ЭтоСправочник Тогда
		Имена.Добавить("Code");
		Имена.Добавить("Description");
	Иначе
		Имена.Добавить("Number");
		Имена.Добавить("Date");
		Имена.Добавить("Posted");
	КонецЕсли;

	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
		// Ссылочные реквизиты в схеме OData имеют суффикс _Key
		Имена.Добавить(Реквизит.Имя + "_Key");
	КонецЦикла;

	Возврат Имена;

КонецФункции

#КонецОбласти

#Область ПреобразованиеИмён

// "Document_РеализацияТоваровУслуг" -> "Документ.РеализацияТоваровУслуг"
Функция ИмяТаблицыПоЛогическомуИмени(ЛогическоеИмя)

	Если СтрНачинаетсяС(ЛогическоеИмя, "Catalog_") Тогда
		Возврат "Справочник." + Сред(ЛогическоеИмя, СтрДлина("Catalog_") + 1);
	ИначеЕсли СтрНачинаетсяС(ЛогическоеИмя, "Document_") Тогда
		Возврат "Документ." + Сред(ЛогическоеИмя, СтрДлина("Document_") + 1);
	ИначеЕсли СтрНачинаетсяС(ЛогическоеИмя, "InformationRegister_") Тогда
		Возврат "РегистрСведений." + Сред(ЛогическоеИмя, СтрДлина("InformationRegister_") + 1);
	ИначеЕсли СтрНачинаетсяС(ЛогическоеИмя, "AccumulationRegister_") Тогда
		Возврат "РегистрНакопления." + Сред(ЛогическоеИмя, СтрДлина("AccumulationRegister_") + 1);
	КонецЕсли;

	ВызватьИсключение "Неизвестный тип объекта: " + ЛогическоеИмя;

КонецФункции

Функция ИмяОбъектаМетаданных(ЛогическоеИмя)
	Позиция = СтрНайти(ЛогическоеИмя, "_");
	Возврат Сред(ЛогическоеИмя, Позиция + 1);
КонецФункции

// Служебные имена схемы OData -> имена встроенного языка.
Функция ИмяПоляПоЛогическомуИмени(Поле)

	ЧистоеПоле = ИмяПоляБезСуффиксаСсылки(Поле);

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Ref_Key", "Ссылка");
	Соответствие.Вставить("Number", "Номер");
	Соответствие.Вставить("Date", "Дата");
	Соответствие.Вставить("Posted", "Проведен");
	Соответствие.Вставить("DeletionMark", "ПометкаУдаления");
	Соответствие.Вставить("Code", "Код");
	Соответствие.Вставить("Description", "Наименование");

	Найденное = Соответствие.Получить(ЧистоеПоле);
	Возврат "Т." + ?(Найденное = Неопределено, ЧистоеПоле, Найденное);

КонецФункции

Функция ИмяПоляБезСуффиксаСсылки(Поле)
	Если СтрЗаканчиваетсяНа(Поле, "_Key") Тогда
		Возврат Лев(Поле, СтрДлина(Поле) - 4);
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ЗначениеПараметра(Условие)

	Вид = Условие.kind;
	Если Вид = "guid" Тогда
		Возврат Новый УникальныйИдентификатор(Условие.value);
	ИначеЕсли Вид = "datetime" Тогда
		Возврат ДатаИзISO(Условие.value);
	ИначеЕсли Вид = "bool" Тогда
		Возврат Условие.value = Истина;
	ИначеЕсли Вид = "number" Тогда
		Возврат Число(Условие.value);
	КонецЕсли;
	Возврат Строка(Условие.value);

КонецФункции

Функция ДатаИзISO(Значение)
	// "2026-07-01T00:00:00" -> Дата. Имя переменной НЕ "Строка": оно перекрыло
	// бы встроенную функцию Строка() в пределах этой функции.
	ТекстДаты = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "-", ""), ":", ""), "T", "");
	Возврат Дата(Лев(ТекстДаты, 14));
КонецФункции

Функция СсылкаИзGUID(ЛогическоеИмя, GUID)
	Идентификатор = Новый УникальныйИдентификатор(GUID);
	ИмяОбъекта = ИмяОбъектаМетаданных(ЛогическоеИмя);
	Если СтрНачинаетсяС(ЛогическоеИмя, "Catalog_") Тогда
		Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Возврат Документы[ИмяОбъекта].ПолучитьСсылку(Идентификатор);
КонецФункции

Функция ЗначениеРеквизита(Документ, ИмяРеквизита, Значение)

	// ОписаниеТипов, а не «Тип»: переменная с таким именем перекрыла бы
	// встроенную функцию Тип("Строка") ниже по коду.
	ОписаниеТипов = Документ.Метаданные().Реквизиты[ИмяРеквизита].Тип;

	Если ОписаниеТипов.СодержитТип(Тип("Строка")) ИЛИ ОписаниеТипов.СодержитТип(Тип("Число"))
		ИЛИ ОписаниеТипов.СодержитТип(Тип("Дата")) ИЛИ ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
		Возврат Значение;
	КонецЕсли;

	// Ссылочный реквизит: из задания пришёл GUID
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Строка(Значение));
	Исключение
		Возврат Значение;
	КонецПопытки;

	Для Каждого ТипРеквизита Из ОписаниеТипов.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
		Если МетаданныеТипа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.Справочники.Найти(МетаданныеТипа.Имя) <> Неопределено Тогда
			Возврат Справочники[МетаданныеТипа.Имя].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Метаданные.Документы.Найти(МетаданныеТипа.Имя) <> Неопределено Тогда
			Возврат Документы[МетаданныеТипа.Имя].ПолучитьСсылку(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Значение;

КонецФункции

Функция СтрокаРезультата(Выборка, Поля)

	// ДанныеСтроки, а не «Строка»: имя перекрыло бы встроенную функцию Строка().
	ДанныеСтроки = Новый Структура;
	Колонки = Выборка.Владелец().Колонки;

	Для Каждого Колонка Из Колонки Цикл
		Значение = Выборка[Колонка.Имя];
		// Имя колонки определяем по ТИПУ поля, а не по значению: у пустого
		// значения тип не распознать, и одно и то же поле называлось то
		// «ИНН», то «ИНН_Key» в разных строках (живая база, 2026-07-31).
		ДанныеСтроки.Вставить(ИмяКолонкиДляОтвета(Колонка.Имя, Колонка.ТипЗначения),
			ЗначениеДляОтвета(Значение));
	КонецЦикла;

	// Поля может прийти как Null (JSON null) — тогда отдаём всё.
	Если Поля = Неопределено ИЛИ Поля = Null Тогда
		Возврат ДанныеСтроки;
	КонецЕсли;

	Отобранная = Новый Структура;
	Для Каждого Поле Из Поля Цикл
		Если ДанныеСтроки.Свойство(Поле) Тогда
			Отобранная.Вставить(Поле, ДанныеСтроки[Поле]);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранная;

КонецФункции

// Ссылочный ли тип поля. Перечисления OData отдаёт обычным именем со
// строковым значением, поэтому суффикс им не положен.
Функция ЭтоСсылочныйТип(ОписаниеТипов)

	Если ОписаниеТипов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ТипПоля Из ОписаниеТипов.Типы() Цикл
		Если ТипПоля = Тип("Строка") ИЛИ ТипПоля = Тип("Число")
			ИЛИ ТипПоля = Тип("Булево") ИЛИ ТипПоля = Тип("Дата")
			ИЛИ ТипПоля = Тип("Null") ИЛИ ТипПоля = Тип("Неопределено") Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипПоля);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ИмяКолонкиДляОтвета(ИмяКолонки, ТипПоля)
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Ссылка", "Ref_Key");
	Соответствие.Вставить("Номер", "Number");
	Соответствие.Вставить("Дата", "Date");
	Соответствие.Вставить("Проведен", "Posted");
	Соответствие.Вставить("ПометкаУдаления", "DeletionMark");
	Соответствие.Вставить("Код", "Code");
	Соответствие.Вставить("Наименование", "Description");

	Найденное = Соответствие.Получить(ИмяКолонки);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;
	// Ссылочные реквизиты отдаём как <Имя>_Key — как это делает OData.
	Если ЭтоСсылочныйТип(ТипПоля) Тогда
		Возврат ИмяКолонки + "_Key";
	КонецЕсли;
	Возврат ИмяКолонки;
КонецФункции

Функция ЗначениеДляОтвета(Значение)

	// ТипЗначения, а не «Тип»: иначе переменная перекроет функцию Тип().
	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	ИначеЕсли ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	// Ссылка -> GUID строкой (как это делает OData)
	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;

КонецФункции

Функция ОшибкаЗадания(Идентификатор, Описание)
	Возврат Новый Структура("id, ok, error", Идентификатор, Ложь, Описание);
КонецФункции

#КонецОбласти

#Область РаботаСJSON

// Имена намеренно отличаются от встроенных ПрочитатьJSON/ЗаписатьJSON:
// одноимённая функция модуля перекрыла бы глобальную, и вызов внутри
// превратился бы в рекурсию.
Функция ПрочитатьJSONИзСтроки(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ЗаписатьJSONВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция РазложитьСтрокуURI(Адрес)
	БезСхемы = СтрЗаменить(Адрес, "http://", "");
	Части = СтрРазделить(БезСхемы, ":", Истина);
	Хост = Части[0];
	Порт = ?(Части.Количество() > 1, Число(СтрРазделить(Части[1], "/", Истина)[0]), 80);
	Возврат Новый Структура("Хост, Порт", Хост, Порт);
КонецФункции

// Пауза только на случай недоступного шлюза: в норме ожидание берёт на себя
// длинный опрос (сервер держит запрос до 25 с), и активное ожидание не нужно.
Процедура ПриостановитьВыполнение(Секунды)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) < Секунды * 1000 Цикл
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Автозапуск

// Настройки автозапуска ищутся в файле perimeter_robot.json рядом с .epf:
//   {"autostart": true, "gateway": "http://10.0.0.5:8092", "token": "..."}
// Без файла (или без autostart) обработка ничего не делает при открытии —
// работу запускает форма или внешний вызов ВыполнитьРаботу().
// Где обработка лежит — форма показывает это человеку, если файла настроек нет.
Функция ПутьОбработки() Экспорт

	Попытка
		Возврат ЭтотОбъект.ИспользуемоеИмяФайла;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ПрочитатьНастройкиАвтозапуска() Экспорт

	Попытка
		ПутьОбработки = ЭтотОбъект.ИспользуемоеИмяФайла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(ПутьОбработки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Файл = Новый Файл(ПутьОбработки);
	ПутьНастроек = Файл.Путь + "perimeter_robot.json";
	ФайлНастроек = Новый Файл(ПутьНастроек);
	Если НЕ ФайлНастроек.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьНастроек, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Настройки = ПрочитатьJSONИзСтроки(Содержимое);
	Если НЕ Настройки.Свойство("autostart") ИЛИ Настройки.autostart <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

#КонецОбласти

// --- Тело модуля объекта ---------------------------------------------------
// Пусто намеренно. Раньше здесь стоял автозапуск блокирующего цикла, но:
//   1) из командной строки тело модуля всё равно не выполняется (проверено);
//   2) при интерактивном открытии такой цикл заморозил бы сеанс бухгалтера.
// Запуском ведает форма — обработчиком ожидания, не блокируя 1С.
